<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#020a18">
  <meta name="description" content="Ingrid Cisneiro Facchim — Business and People Leader exploring Big Data and AI in Business. A personal journey through leadership, operations and emerging technology.">

  <title>Ingrid Cisneiro Facchim | Business, Data & AI</title>

  <!-- Open Graph -->
  <meta property="og:title" content="Ingrid Cisneiro Facchim | Business, Data & AI">
  <meta property="og:description" content="Building on years of business and people leadership, exploring how data, technology and AI can transform business decisions and operations.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="">

  <!-- Add og:image later: 1200x630 PNG matching dark theme -->

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Ingrid Cisneiro Facchim | Business, Data & AI">
  <meta name="twitter:description" content="My journey from business and people leadership into Big Data and AI in Business.">
  <meta name="twitter:url" content="">

  <!-- Emoji SVG favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='85'%3E%F0%9F%A7%A0%3C/text%3E%3C/svg%3E">

  <!-- Apply saved theme before first paint -->
  <script>
    (function () {
      try {
        const saved = localStorage.getItem("ingrid-theme");
        if (saved === "light") {
          document.documentElement.classList.add("light");
        }
      } catch (error) {
        // Storage may be unavailable; dark mode remains the default.
      }
    })();
  </script>

  <!-- Google Fonts: only external dependency -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700;750;800&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: dark;

      --bg: #020a18;
      --bg-grad: linear-gradient(170deg, #020a18 0%, #041028 40%, #06142e 70%, #020a18 100%);
      --surface: rgba(8,24,56,0.85);
      --border: rgba(0,170,255,0.12);
      --border-glow: rgba(0,170,255,0.3);
      --text: #d0e0f0;
      --text-bright: #e8f0ff;
      --text-dim: #6888aa;

      --neon: #00aaff;
      --cyan: #00e5ff;
      --green: #00ff88;
      --amber: #ffaa00;
      --red: #ff4466;
      --purple: #aa66ff;

      --header-bg: rgba(2,10,24,0.78);
      --grid-color: rgba(130,185,255,0.03);
      --orb-one: rgba(0,170,255,0.08);
      --orb-two: rgba(170,102,255,0.08);
      --orb-three: rgba(0,229,255,0.06);
      --button-text: #020a18;
      --soft-surface: rgba(0,170,255,0.045);
      --shadow: rgba(0,0,0,0.18);
      --tag-bg: rgba(0,170,255,0.09);
      --tag-border: rgba(0,170,255,0.18);
      --timeline-line: rgba(0,170,255,0.19);
      --hero-highlight: #b7eaff;
    }

    html.light {
      color-scheme: light;

      --bg: #eef3fa;
      --bg-grad: linear-gradient(170deg, #f5f8fd 0%, #e9f1fb 40%, #e5edfa 70%, #f4f7fc 100%);
      --surface: rgba(255,255,255,0.94);
      --border: rgba(18,70,120,0.17);
      --border-glow: rgba(0,95,180,0.32);
      --text: #344761;
      --text-bright: #10253f;
      --text-dim: #5b718d;

      --neon: #0068bb;
      --cyan: #007f9d;
      --green: #087f51;
      --amber: #a46300;
      --red: #c92e50;
      --purple: #7543bc;

      --header-bg: rgba(244,248,253,0.88);
      --grid-color: rgba(27,80,140,0.035);
      --orb-one: rgba(0,120,215,0.055);
      --orb-two: rgba(130,80,220,0.045);
      --orb-three: rgba(0,150,190,0.045);
      --button-text: #ffffff;
      --soft-surface: rgba(0,95,180,0.045);
      --shadow: rgba(22,55,100,0.08);
      --tag-bg: rgba(0,95,180,0.075);
      --tag-border: rgba(0,95,180,0.16);
      --timeline-line: rgba(0,95,180,0.2);
      --hero-highlight: #005b9d;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 105px;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Inter", -apple-system, BlinkMacSystemFont,
        "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 16px;
      line-height: 1.65;
      color: var(--text);
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    button {
      font: inherit;
    }

    button:focus-visible,
    a:focus-visible {
      outline: 2px solid var(--cyan);
      outline-offset: 4px;
    }

    a {
      color: var(--neon);
      text-decoration: none;
      transition: color .2s ease, text-shadow .2s ease;
    }

    a:hover {
      color: var(--cyan);
      text-shadow: 0 0 15px var(--border-glow);
    }

    ::selection {
      background: var(--border-glow);
      color: var(--text-bright);
    }

    /* BACKGROUND DEPTH */

    .background-gradient {
      position: fixed;
      inset: 0;
      z-index: -4;
      pointer-events: none;
      background: var(--bg-grad);
    }

    .background-grid {
      position: fixed;
      inset: 0;
      z-index: -3;
      pointer-events: none;
      background-image:
        linear-gradient(var(--grid-color) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    .orb-layer {
      position: fixed;
      inset: 0;
      z-index: -2;
      overflow: hidden;
      pointer-events: none;
    }

    .orb {
      position: absolute;
      width: 350px;
      height: 350px;
      border-radius: 50%;
      filter: blur(100px);
      will-change: transform;
    }

    .orb-one {
      top: 5%;
      left: -350px;
      background: var(--orb-one);
      animation: orbit-one 24s ease-in-out infinite alternate;
    }

    .orb-two {
      top: 45%;
      right: -350px;
      background: var(--orb-two);
      animation: orbit-two 29s ease-in-out infinite alternate;
    }

    .orb-three {
      bottom: -220px;
      left: -350px;
      background: var(--orb-three);
      animation: orbit-three 34s ease-in-out infinite alternate;
    }

    @keyframes orbit-one {
      from { transform: translate(0,0) rotate(0deg); }
      to { transform: translate(55px,100px) rotate(30deg); }
    }

    @keyframes orbit-two {
      from { transform: translate(0,0) rotate(0deg); }
      to { transform: translate(-55px,-110px) rotate(-30deg); }
    }

    @keyframes orbit-three {
      from { transform: translate(0,0); }
      to { transform: translate(65px,-100px); }
    }

    /* SHARED LAYOUT */

    .container {
      width: 100%;
      max-width: 880px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .page-content {
      position: relative;
      z-index: 1;
    }

    /* HEADER */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--header-bg);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .header-inner {
      min-height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .header-name {
      font-size: .88rem;
      font-weight: 750;
      letter-spacing: -.035em;
      color: var(--text-bright);
      white-space: nowrap;
    }

    .header-name .dot {
      color: var(--neon);
    }

    .header-actions {
      display: flex;
      gap: 10px;
      flex-shrink: 0;
    }

    .icon-button {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      width: 39px;
      height: 39px;
      padding: 0;
      border-radius: 11px;
      border: 1px solid var(--border);
      color: var(--text);
      background: var(--soft-surface);
      cursor: pointer;
      transition: border-color .2s ease,
        color .2s ease, transform .2s ease;
    }

    .icon-button:hover {
      border-color: var(--border-glow);
      color: var(--cyan);
      transform: translateY(-2px);
    }

    .icon-button svg {
      width: 19px;
      height: 19px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .sun-icon {
      display: block;
    }

    .moon-icon {
      display: none;
    }

    html.light .sun-icon {
      display: none;
    }

    html.light .moon-icon {
      display: block;
    }

    /* HERO */

    .hero {
      padding: 100px 0 77px;
      border-bottom: 1px solid var(--border);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 25px;
      color: var(--green);
      font-size: .72rem;
      font-weight: 750;
      letter-spacing: .17em;
      text-transform: uppercase;
    }

    .eyebrow-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 12px var(--green);
    }

    .hero h1 {
      margin: 0;
      max-width: 790px;
      font-size: clamp(3.1rem, 7.4vw, 5.65rem);
      line-height: 1.06;
      letter-spacing: -.07em;
      font-weight: 800;
      color: var(--text-bright);
    }

    .hero h1 .surname {
      display: block;
      color: var(--hero-highlight);
    }

    .role-line {
      margin: 26px 0 29px;
      font-size: clamp(.92rem, 2.3vw, 1.07rem);
      font-weight: 650;
      color: var(--cyan);
      letter-spacing: -.015em;
    }

    .role-separator {
      color: var(--text-dim);
      margin: 0 7px;
    }

    .hero-statement {
      margin: 0 0 34px;
      max-width: 730px;
      font-size: clamp(1.22rem, 3vw, 1.65rem);
      line-height: 1.55;
      font-weight: 450;
      letter-spacing: -.025em;
      color: var(--text);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
    }

    .primary-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 14px 22px;
      border: 1px solid transparent;
      border-radius: 10px;
      color: var(--button-text);
      background: var(--neon);
      font-size: .9rem;
      font-weight: 750;
      line-height: 1.4;
      box-shadow: 0 6px 26px rgba(0,170,255,.12);
      transition: transform .2s ease,
        background .2s ease, box-shadow .2s ease;
    }

    .primary-cta:hover {
      color: var(--button-text);
      background: var(--cyan);
      text-shadow: none;
      transform: translateY(-2px);
      box-shadow: 0 8px 30px var(--border-glow);
    }

    .primary-cta svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .hero-location {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: .82rem;
      color: var(--text-dim);
    }

    .hero-location svg {
      width: 15px;
      height: 15px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
    }

    /* INTRO */

    .content-intro {
      padding: 48px 0 24px;
    }

    .section-overline {
      margin: 0 0 9px;
      color: var(--neon);
      font-size: .7rem;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: .18em;
    }

    .content-intro h2 {
      margin: 0;
      color: var(--text-bright);
      font-size: 1.7rem;
      letter-spacing: -.045em;
      font-weight: 750;
    }

    .content-intro p:last-child {
      margin: 9px 0 0;
      color: var(--text-dim);
      font-size: .9rem;
    }

    /* COLLAPSIBLE SECTIONS */

    .sections {
      padding-bottom: 70px;
    }

    .section-card {
      margin: 16px 0;
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: 0 8px 28px var(--shadow);
      transition: border-color .25s ease,
        box-shadow .25s ease;
    }

    .section-card:hover {
      border-color: var(--border-glow);
    }

    .section-toggle {
      display: flex;
      align-items: center;
      width: 100%;
      padding: 23px 25px;
      border: 0;
      background: transparent;
      color: var(--text-bright);
      text-align: left;
      cursor: pointer;
      gap: 17px;
    }

    .section-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      border: 1px solid var(--border-glow);
      border-radius: 50%;
      background: var(--soft-surface);
      color: var(--neon);
      font-size: .76rem;
      font-weight: 750;
      font-variant-numeric: tabular-nums;
    }

    .section-title {
      flex: 1;
      font-size: clamp(1rem, 2.7vw, 1.2rem);
      font-weight: 750;
      letter-spacing: -.035em;
    }

    .section-sign {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      flex-shrink: 0;
      color: var(--text-dim);
    }

    .section-sign::before,
    .section-sign::after {
      content: "";
      position: absolute;
      background: currentColor;
      border-radius: 2px;
      transition: transform .25s ease,
        opacity .25s ease;
    }

    .section-sign::before {
      width: 14px;
      height: 2px;
    }

    .section-sign::after {
      width: 2px;
      height: 14px;
      transform: rotate(90deg);
      opacity: 0;
    }

    .section-card.closed .section-sign::after {
      transform: rotate(0deg);
      opacity: 1;
    }

    .section-panel {
      display: grid;
      grid-template-rows: 1fr;
      opacity: 1;
      transition: grid-template-rows .36s ease,
        opacity .28s ease;
    }

    .section-card.closed .section-panel {
      grid-template-rows: 0fr;
      opacity: 0;
    }

    .section-panel-inner {
      min-height: 0;
      overflow: hidden;
    }

    .section-content {
      padding: 0 25px 27px 78px;
      border-top: 1px solid transparent;
    }

    .section-content p {
      margin: 0 0 17px;
    }

    .section-content p:last-child {
      margin-bottom: 0;
    }

    .section-content strong {
      color: var(--text-bright);
      font-weight: 650;
    }

    .section-lead {
      color: var(--text-bright);
      font-size: 1.01rem;
      line-height: 1.75;
    }

    .accent-text {
      color: var(--cyan);
    }

    .small-heading {
      margin: 26px 0 13px;
      font-size: .75rem;
      font-weight: 750;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--neon);
    }

    /* TAGS */

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 20px;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      padding: 5px 11px;
      border: 1px solid var(--tag-border);
      border-radius: 6px;
      background: var(--tag-bg);
      color: var(--text);
      font-size: .75rem;
      font-weight: 550;
    }

    /* TIMELINE */

    .timeline {
      position: relative;
      padding-left: 24px;
      margin: 10px 0 0;
      border-left: 1px solid var(--timeline-line);
    }

    .timeline-item {
      position: relative;
      padding: 0 0 25px 0;
    }

    .timeline-item:last-child {
      padding-bottom: 0;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      left: -29px;
      top: 7px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--neon);
      box-shadow: 0 0 0 4px var(--surface);
    }

    .timeline-date {
      display: block;
      margin-bottom: 4px;
      color: var(--text-dim);
      font-size: .76rem;
      font-weight: 650;
    }

    .timeline-role {
      display: block;
      color: var(--text-bright);
      font-size: .98rem;
      font-weight: 700;
    }

    .timeline-company {
      display: block;
      margin: 2px 0 7px;
      color: var(--cyan);
      font-size: .8rem;
      font-weight: 600;
    }

    .timeline-item p {
      margin: 5px 0 0;
      font-size: .88rem;
      line-height: 1.7;
    }

    /* ACHIEVEMENT CARDS */

    .achievement-list {
      display: grid;
      gap: 13px;
      margin-top: 18px;
    }

    .achievement {
      padding: 18px 19px;
      border: 1px solid var(--border);
      border-radius: 11px;
      background: var(--soft-surface);
    }

    .achievement-top {
      display: flex;
      align-items: flex-start;
      gap: 11px;
      margin-bottom: 9px;
    }

    .achievement-marker {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 27px;
      height: 27px;
      flex-shrink: 0;
      border-radius: 8px;
      background: var(--tag-bg);
      color: var(--green);
      font-size: .8rem;
      font-weight: 750;
    }

    .achievement h3 {
      margin: 0;
      color: var(--text-bright);
      font-size: .95rem;
      line-height: 1.5;
      font-weight: 700;
    }

    .achievement p {
      margin: 0;
      font-size: .87rem;
      line-height: 1.75;
    }

    /* EDUCATION */

    .education-item {
      padding: 17px 0;
      border-bottom: 1px solid var(--border);
    }

    .education-item:first-child {
      padding-top: 0;
    }

    .education-item:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .education-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 8px;
      color: var(--green);
      font-size: .72rem;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: .09em;
    }

    .education-item h3 {
      margin: 0 0 5px;
      font-size: .98rem;
      line-height: 1.55;
      color: var(--text-bright);
      font-weight: 700;
    }

    .education-item p {
      margin: 0;
      font-size: .85rem;
      color: var(--text-dim);
    }

    /* FUTURE DIRECTION */

    .direction-list {
      display: grid;
      gap: 14px;
      margin: 20px 0;
    }

    .direction-item {
      display: flex;
      align-items: flex-start;
      gap: 13px;
    }

    .direction-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      flex-shrink: 0;
      border: 1px solid var(--tag-border);
      border-radius: 9px;
      color: var(--cyan);
      background: var(--tag-bg);
      font-weight: 750;
      font-size: .83rem;
    }

    .direction-item strong {
      display: block;
      margin: 1px 0 3px;
      font-size: .9rem;
    }

    .direction-item p {
      margin: 0;
      font-size: .86rem;
    }

    .closing-thought {
      margin-top: 25px;
      padding: 19px 20px;
      border-left: 3px solid var(--neon);
      border-radius: 0 9px 9px 0;
      background: var(--soft-surface);
      color: var(--text-bright);
      font-size: .93rem;
      font-weight: 500;
      line-height: 1.8;
    }

    /* FOOTER */

    .site-footer {
      border-top: 1px solid var(--border);
      padding: 29px 0 38px;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px 20px;
      color: var(--text-dim);
      font-size: .75rem;
    }

    .footer-inner strong {
      color: var(--text);
      font-weight: 650;
    }

    .footer-mark {
      color: var(--neon);
    }

    /* RESPONSIVE */

    @media (max-width: 600px) {
      .header-inner {
        min-height: 64px;
      }

      .header-name {
        font-size: .78rem;
        letter-spacing: -.04em;
      }

      .header-actions {
        gap: 7px;
      }

      .icon-button {
        width: 36px;
        height: 36px;
      }

      .hero {
        padding: 72px 0 59px;
      }

      .hero h1 {
        font-size: clamp(2.65rem, 11vw, 4rem);
      }

      .role-line {
        line-height: 1.9;
      }

      .role-separator {
        margin: 0 4px;
      }

      .hero-statement {
        font-size: 1.2rem;
      }

      .content-intro {
        padding-top: 37px;
      }

      .section-toggle {
        padding: 19px 17px;
        gap: 12px;
      }

      .section-number {
        width: 32px;
        height: 32px;
      }

      .section-content {
        padding: 0 18px 23px 18px;
      }

      .section-title {
        font-size: 1.02rem;
      }

      .sections {
        padding-bottom: 45px;
      }

      .footer-inner {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 370px) {
      .header-name {
        font-size: .7rem;
      }

      .header-actions {
        gap: 5px;
      }

      .icon-button {
        width: 33px;
        height: 33px;
      }
