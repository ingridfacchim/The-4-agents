  <script>
    (function () {
      "use strict";

      const root = document.documentElement;
      const themeButton = document.getElementById("theme-toggle");
      const expandButton = document.getElementById("expand-toggle");
      const sectionCards = Array.from(
        document.querySelectorAll(".section-card")
      );

      // THEME MANAGEMENT

      function updateThemeButton() {
        const isLight = root.classList.contains("light");
        const label = isLight
          ? "Switch to dark mode"
          : "Switch to light mode";

        themeButton.setAttribute("title", label);
        themeButton.setAttribute("aria-label", label);

        const themeMeta = document.querySelector(
          'meta[name="theme-color"]'
        );

        if (themeMeta) {
          themeMeta.setAttribute(
            "content",
            isLight ? "#f5f8fd" : "#020a18"
          );
        }
      }

      themeButton.addEventListener("click", function () {
        const isLight = root.classList.toggle("light");

        try {
          localStorage.setItem(
            "ingrid-theme",
            isLight ? "light" : "dark"
          );
        } catch (error) {
          // Theme still works if storage is unavailable.
        }

        updateThemeButton();
      });

      updateThemeButton();

      // COLLAPSIBLE SECTIONS

      function setSectionOpen(card, open) {
        const toggle = card.querySelector(".section-toggle");
        const panel = card.querySelector(".section-panel");

        card.classList.toggle("closed", !open);
        toggle.setAttribute("aria-expanded", String(open));

        // Inert prevents keyboard navigation into closed panels.
        if ("inert" in panel) {
          panel.inert = !open;
        }
      }

      function allSectionsOpen() {
        return sectionCards.every(function (card) {
          return !card.classList.contains("closed");
        });
      }

      function updateExpandButton() {
        const allOpen = allSectionsOpen();
        const label = allOpen
          ? "Collapse all sections"
          : "Expand all sections";

        expandButton.setAttribute("title", label);
        expandButton.setAttribute("aria-label", label);
        expandButton.setAttribute(
          "aria-expanded",
          String(allOpen)
        );
      }

      sectionCards.forEach(function (card) {
        const toggle = card.querySelector(".section-toggle");

        // All sections open by default.
        setSectionOpen(card, true);

        toggle.addEventListener("click", function () {
          const isOpen = !card.classList.contains("closed");

          setSectionOpen(card, !isOpen);
          updateExpandButton();
        });
      });

      expandButton.addEventListener("click", function () {
        const shouldOpen = !allSectionsOpen();

        sectionCards.forEach(function (card) {
          setSectionOpen(card, shouldOpen);
        });

        updateExpandButton();
      });

      updateExpandButton();

      // OPEN SECTION WHEN NAVIGATING TO ITS ANCHOR

      function openHashTarget() {
        const hash = window.location.hash;

        if (!hash) return;

        let id;

        try {
          id = decodeURIComponent(hash.slice(1));
        } catch (error) {
          return;
        }

        const target = document.getElementById(id);

        if (!target) return;

        const card = target.classList.contains("section-card")
          ? target
          : target.closest(".section-card");

        if (card) {
          setSectionOpen(card, true);
          updateExpandButton();
        }
      }

      window.addEventListener("hashchange", openHashTarget);
      openHashTarget();

      // FOOTER YEAR

      document.getElementById("current-year").textContent =
        new Date().getFullYear();
    })();
  </script>
